┌──(sana㉿kali-Sana)-[/home/sana/projects/linux-virtual-network]
└─PS> sudo nft list table ip lvc_nat
table ip lvc_nat {
        chain postrouting {
                type nat hook postrouting priority srcnat; policy accept;
                ip saddr 10.10.0.0/16 oifname "wlan0" masquerade
        }
}

